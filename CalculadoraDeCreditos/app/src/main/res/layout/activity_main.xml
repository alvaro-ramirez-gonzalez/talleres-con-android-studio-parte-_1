<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/valor_credito"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etCredito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/ingrese_credito"
            android:inputType="numberDecimal"
            android:autofillHints="none"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/numero_cuotas"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etCuotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/ingrese_cuotas"
            android:inputType="number"
            android:autofillHints="none"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/interes_mensual"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etInteres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/ejemplo_interes"
            android:inputType="numberDecimal"
            android:autofillHints="none"
            android:layout_marginBottom="25dp" />

        <Button
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calcular"
            android:layout_marginBottom="25dp" />

        <TextView
            android:id="@+id/tvCuota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/valor_cuota"
            android:textSize="18sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/valor_total"
            android:textSize="18sp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:id="@+id/tvIntereses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/total_intereses"
            android:textSize="18sp" />

    </LinearLayout>

</ScrollView>